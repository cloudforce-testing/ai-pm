{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-pm",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-pm",
      "database_id": "5113673f-321b-42e1-afdd-8102f2ba016c"
    }
  ]
  // 登入密碼不放在這裡，請用 `npx wrangler secret put APP_PASSWORD` 設定
}
